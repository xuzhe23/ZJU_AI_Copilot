# ================= Provider 开关 =================
# OFFLINE_MODE=true  → 纯本地兜底可跑（零平台依赖）
# OFFLINE_MODE=false → 启用平台 API（需配置对应 Key）
OFFLINE_MODE=true
USE_EMBEDDING=false

# ================= 数据处理 / 对话输出：千问办公 → DashScope(Qwen) =================
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_EMBED_MODEL=text-embedding-v3
QWEN_RERANK_MODEL=qwen3-rerank

# ================= 数据来源：浙大教育智能体平台 / 浙大先生 =================
ZJU_API_KEY=
ZJU_BASE_URL=https://aihub.zju.edu.cn/v1
ZJU_MODEL=qwen-plus

# ================= Qcoder（可选：仅作写代码辅助 Agent，非对话后端）================
QODER_PERSONAL_ACCESS_TOKEN=

# ================= 本地路径 =================
DATA_DIR=data
INGEST_DIR=data/ingest
LOGS_DIR=data/logs
KB_DIR=data/kb
OUTPUT_DIR=data/outputs
